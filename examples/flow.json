    "func": "const id = msg.parameters.path.petId;\nif (id === 7) {\n  msg.statusCode = 200;\n  msg.payload = { id: 7, name: 'Rex', tag: 'dog' };\n} else {\n  msg.error = { statusCode: 404, title: 'Not Found', detail: 'no pet ' + id };\n}\nreturn msg;",
